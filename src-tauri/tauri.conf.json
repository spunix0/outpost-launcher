{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outpost Launcher",
  "version": "0.1.2",
  "identifier": "dev.outpost.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Outpost Launcher",
        "width": 1070,
        "height": 620,
        "minWidth": 900,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
